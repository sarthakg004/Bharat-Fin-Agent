# What `gcloud run deploy --source .` uploads to Cloud Build. The image needs
# only finagent/, frontend/ and the requirements, so everything else stays out.

.git/
.github/
node_modules/
frontend/node_modules/
frontend/dist/
**/__pycache__/
**/*.pyc
.venv/
venv/
.env
.env.*
!.env.example
results/
notebooks/
tests/
*.egg-info/
.pytest_cache/
.ruff_cache/

data/
chroma.tar.gz

logs/
scripts/
interview_notes/
*.md
!README.md
