# Controls what `gcloud run deploy --source .` uploads to Cloud Build.
# IMPORTANT: gcloud falls back to .gitignore when this file is absent, and
# .gitignore excludes data/ — which would drop the Chroma store the image needs.
# This file overrides that: we ignore data/ EXCEPT data/chroma.
#
# (For a 670 MB store, building locally with `docker build` + pushing to
# Artifact Registry is often faster than re-uploading on every --source deploy.)

.git/
.github/
node_modules/
frontend/node_modules/
frontend/dist/
**/__pycache__/
**/*.pyc
.venv/
venv/
.env
.env.*
!.env.example
results/
notebooks/
tests/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Keep ONLY data/chroma (baked into the image); exclude the rest of data/.
# We list the non-chroma items EXPLICITLY rather than `data/*` + `!data/chroma`,
# because that re-include is unreliable in gcloud's ignore parser and was
# silently dropping data/chroma from the upload.
data/us/
data/India/
data/tables/
data/*.db
data/*.csv
data/*.txt

# The Chroma tarball CI downloads from GCS and unpacks into data/chroma/.
# The build only needs the unpacked data/chroma/ — uploading the tarball too
# would ship the Chroma store TWICE in the source zip (~360 MB wasted).
chroma.tar.gz
