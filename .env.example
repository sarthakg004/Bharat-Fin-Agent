# Copy to .env and fill in. Only GROQ_API_KEY is strictly required for local dev.

# ── LLM provider (default) ───────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# Optional extra Groq keys from DIFFERENT orgs → RotatingChatModel cycles them
# on rate-limit (GROQ_API_KEY2 … GROQ_API_KEY8).
# GROQ_API_KEY2=gsk_...

# ── Tools ────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...          # web search (recommended)

# ── Vector store ─────────────────────────────────────────────────────────────
# Qdrant cluster holding the corpus (required — there is no local fallback).
# QDRANT_URL=https://<cluster>.cloud.qdrant.io:6333
# QDRANT_API_KEY=...

# ── Server mode ──────────────────────────────────────────────────────────────
# Dynamic SEC fetch persistence. Default (unset/true) = a fetched filing is
# upserted into the shared Qdrant collection. Deterministic point ids make a
# duplicate write an overwrite, so concurrent writers are safe.
# PERSIST_DYNAMIC_FETCH=true

# RAG_MAX_WORKERS — graph-execution concurrency. Default 1 (serialized): the
# storage layer no longer requires it, but the cross-encoder and HF tokenizers
# are the memory-heavy, not-fully-thread-safe part. This is a capacity knob now.
# RAG_MAX_WORKERS=1

# ── Tracing (optional) ───────────────────────────────────────────────────────
# Langfuse (open source) — per-node traces, prompts/completions, token costs.
# Keys from Langfuse UI → Settings → API Keys. Tracing is off without them.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # or us./jp. region, or self-hosted
# LangSmith (hosted alternative; auto-traced by LangChain when set)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=finagent

# ── Compute (optional) ───────────────────────────────────────────────────────
# FINAGENT_DEVICE=cpu              # force device for embeddings/reranker (auto-detects)

# ── Per-request providers (optional; users normally paste these in the UI) ────
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
