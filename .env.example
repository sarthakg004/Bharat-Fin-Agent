# Copy to .env and fill in.
# Each *_API_KEYS variable holds one key or several, separated by commas.
# With several keys, a rate-limited key is swapped for the next one.

# Required
GROQ_API_KEYS=gsk_...            # planner and extractors (qwen/qwen3.8-27b)
GEMINI_API_KEYS=AIza...          # writer, critic and embeddings
QDRANT_URL=https://<cluster>.cloud.qdrant.io
QDRANT_API_KEY=...

# Recommended
COHERE_API_KEYS=...              # reranker; without it the local cross-encoder is used
TAVILY_API_KEY=tvly-...          # web search
SEC_UA_NAME=Your Name            # the SEC asks every client to identify itself
SEC_UA_EMAIL=you@example.com

# Optional
# US_COLLECTION=us_filings_v5_gemini
# RERANKER_MODEL=cohere:rerank-v4.0-pro
# ALLOWED_ORIGINS=https://your-frontend.example
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Evaluation only: the eval corpus lives on a local Qdrant
# QDRANT_EVAL_URL=http://localhost:6333
# FINANCEBENCH_COLLECTION=sweep_p2500_c600_gemini-embedding-2_hdr_tbl-md
