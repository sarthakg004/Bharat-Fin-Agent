# Copy to .env and fill in. Only GROQ_API_KEY is strictly required for local dev.

# ── LLM provider (default) ───────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# Optional extra Groq keys from DIFFERENT orgs → RotatingChatModel cycles them
# on rate-limit (GROQ_API_KEY2 … GROQ_API_KEY8).
# GROQ_API_KEY2=gsk_...

# ── Tools ────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...          # web search (recommended)

# ── Vector store ─────────────────────────────────────────────────────────────
# On-disk Chroma (baked into the image for deployment).
# CHROMA_DIR=data/chroma

# ── Server mode ──────────────────────────────────────────────────────────────
# STATELESS=1 → no server-side chat store; the client sends chat_history per
# request (per-session memory). Leave unset locally to use the SQLite chat store.
# STATELESS=1

# Dynamic SEC fetch persistence. Default (unset/true) = persist a fetched filing
# into the on-disk index (self-expanding corpus; good locally). On Cloud Run set
# PERSIST_DYNAMIC_FETCH=false so a fetched filing is used IN MEMORY for the
# session only — no index growth, no persistence, no scale-to-zero problem.
# PERSIST_DYNAMIC_FETCH=false

# RAG_MAX_WORKERS — graph-execution concurrency. Default 1 (serialized) because
# the native stacks (Chroma/hnswlib, CUDA) aren't safe across threads.
# RAG_MAX_WORKERS=1

# ── Tracing (optional) ───────────────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=finagent

# ── Compute (optional) ───────────────────────────────────────────────────────
# FINAGENT_DEVICE=cpu              # force device for embeddings/reranker (auto-detects)

# ── Per-request providers (optional; users normally paste these in the UI) ────
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
