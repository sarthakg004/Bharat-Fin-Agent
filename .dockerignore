# Build context for the Cloud Run image.
# Keep ONLY data/chroma (baked into the image); exclude the rest of data/
# explicitly (no fragile `data/*` + `!data/chroma` re-include).
data/us/
data/India/
data/tables/
data/*.db
data/*.csv
data/*.txt

results/
notebooks/
tests/

frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
**/__pycache__/
**/*.pyc
.venv/
venv/
.git/
.github/
.env
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
*.egg-info/
